import "./style.css";
import type { Listener } from "@elements/app";
import { ValidationError } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card } from "@elements/ui/card";
import { Field, FieldLabel } from "@elements/ui/field";
import { Icon } from "@elements/ui/icon";
import { Input } from "@elements/ui/input";
import { Textarea } from "@elements/ui/textarea";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Host, MeetingType, SlotChange, bookSlot } from "#app/shared/services/scheduling";
import { PublicLayout } from "#app/shared/templates/public-layout";
import { MeetingSummary } from "#app/shared/templates/meeting-summary";
import { SlotPicker, Pick } from "#app/shared/templates/slot-picker";
import { formatShortDay, formatTime } from "#app/shared/lib/time";

interface GuestForm {
  guestName: string;
  guestEmail: string;
  guestNote: string;
  errors: Record<string, string[]>;
  error: string;
  busy: boolean;
  token: string;
  bookedAt: Date | null;
}

function onBook(form: GuestForm, pick: Pick, type: MeetingType) {
  if (!pick.startsAt) {
    return;
  }

  // The live slot feed can clear the pick while the booking is in flight.
  let startsAt = pick.startsAt;
  form.busy = true;
  try {
    let result = bookSlot({
      meetingTypeId: type.id,
      startsAt,
      guestName: form.guestName,
      guestEmail: form.guestEmail,
      guestNote: form.guestNote,
      guestTimeZone: pick.timeZone,
    });

    form.bookedAt = startsAt;
    form.token = result.token;
    form.errors = {};
    form.error = "";
  } catch (err: any) {
    if (err instanceof ValidationError && err.errors) {
      form.errors = err.errors as Record<string, string[]>;
      form.error = "";
    } else {
      form.errors = {};
      form.error = err.message;
      pick.startsAt = null;
      pick.notice = err.message;
    }
  }

  form.busy = false;
}

<html lang="en" class="page-book" (
  host: Host,
  type: MeetingType,
  slots: Date[],
  listener: Listener<SlotChange>,
  private pick: Pick = { startsAt: null, timeZone: host.timeZone, notice: "" },
  private form: GuestForm = {
    guestName: "",
    guestEmail: "",
    guestNote: "",
    errors: {},
    error: "",
    busy: false,
    token: "",
    bookedAt: null,
  },
)>
  <head>
    <title>{type.name} with {host.name} · slotnook</title>
    <meta name="description" content={`Book a ${type.name.toLowerCase()} with ${host.name}.`}>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <PublicLayout>
      <Card class="booking-card">
        <aside class="booking-aside">
          <MeetingSummary {host} {type} startsAt={form.bookedAt ?? pick.startsAt} timeZone={pick.timeZone} />
        </aside>

        <div class="booking-main">
          <div e:if={form.token} class="booking-done stack">
            <span class="booking-check" aria-hidden="true"><Icon name="check" size={22} /></span>
            <h2>You're booked</h2>
            <p>A confirmation with a calendar invite is on its way to <strong>{form.guestEmail}</strong>. It has links to reschedule or cancel if plans change.</p>
            <div class="cluster">
              <Button variant="primary" href={`/booking/${form.token}`}>View booking</Button>
              <Button variant="ghost" href={`/${host.slug}`}>More with {host.name.split(" ")[0]}</Button>
            </div>
          </div>

          <div e:else class="stack is-lg">
            <div class={["stack", pick.startsAt && "hidden"]}>
              <h2>Pick a day and time</h2>
              <Alert e:if={pick.notice} variant="warning" role="status" description={pick.notice} />
              <SlotPicker meetingTypeId={type.id}
                          durationMinutes={type.durationMinutes}
                          bufferMinutes={type.bufferMinutes}
                          {slots}
                          {listener}
                          {pick} />
            </div>

            <form e:if={pick.startsAt} class="booking-form stack" onsubmit={() => onBook(form, pick, type)}>
              <h2>Your details</h2>

              <div class="booking-picked row">
                <span>{formatShortDay(pick.startsAt!, pick.timeZone)} at {formatTime(pick.startsAt!, pick.timeZone)}</span>
                <Button variant="ghost" size="sm" onclick={() => pick.startsAt = null}>Change</Button>
              </div>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Name" error={form.errors.guestName?.[0] ?? ""}>
                <Input value={form.guestName} name="name" required attrs={{ id: "guest-name", autocomplete: "name" }} />
              </Field>

              <Field label="Email" error={form.errors.guestEmail?.[0] ?? ""}>
                <Input value={form.guestEmail}
                       name="email"
                       type="email"
                       required
                       attrs={{ id: "guest-email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field>
                <FieldLabel>Anything {host.name.split(" ")[0]} should know? <span class="text-ink-dim">(optional)</span></FieldLabel>
                <Textarea value={form.guestNote} name="note" rows={3} attrs={{ id: "guest-note" }} />
              </Field>

              <Button type="submit" variant="primary" size="lg" loading={form.busy}>Confirm booking</Button>
            </form>
          </div>
        </div>
      </Card>
    </PublicLayout>
  </body>
</html>
