import "./style.css";
import type { Listener } from "@elements/app";
import { session, sql } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { AlertDialog, AlertDialogFooter, AlertDialogCancel, AlertDialogAction } from "@elements/ui/alert-dialog";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card } from "@elements/ui/card";
import { Empty, EmptyDescription } from "@elements/ui/empty";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@elements/ui/tabs";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Host, SlotChange, hostCancel } from "#app/shared/services/scheduling";
import { HostLayout } from "#app/shared/templates/host-layout";
import { dayKey, formatDay, formatTime, zoneName, zoneAbbr } from "#app/shared/lib/time";

export interface HostBooking {
  id: string;
  startsAt: Date;
  endsAt: Date;
  status: "confirmed" | "cancelled";
  guestName: string;
  guestEmail: string;
  guestNote: string;
  guestTimeZone: string;
  meetingName: string;
  createdAt: Date;
}

interface DayGroup {
  id: string;
  label: string;
  bookings: HostBooking[];
}

type Tab = "upcoming" | "past";

interface BookingsView {
  tab: string;
  error: string;
  seen: string[];
}

export function loadHostBookings(hostId: string): HostBooking[] {
  return sql<HostBooking>(`
    select b.id, b.startsAt, b.endsAt, b.status, b.guestName, b.guestEmail, b.guestNote,
           b.guestTimeZone, b.createdAt, m.name as meetingName
      from bookings b
      join meetingTypes m on m.id = b.meetingTypeId
     where b.userId = ${hostId}
       and b.startsAt > now() - interval '90 days'
     order by b.startsAt
  `).all();
}

/** @rpc */
export function fetchMyBookings(): HostBooking[] {
  return loadHostBookings(session.getOrThrow("userId"));
}

function isUpcoming(b: HostBooking): boolean {
  return b.status === "confirmed" && b.endsAt.getTime() > Date.now();
}

function groupByDay(bookings: HostBooking[], tab: Tab, timeZone: string): DayGroup[] {
  let list = tab === "upcoming"
    ? bookings.filter(isUpcoming)
    : bookings.filter((b) => !isUpcoming(b)).reverse();

  let groups: DayGroup[] = [];
  for (let b of list) {
    let key = dayKey(b.startsAt, timeZone);
    let last = groups[groups.length - 1];
    if (last && last.id === key) {
      last.bookings.push(b);
    } else {
      groups.push({ id: key, label: formatDay(b.startsAt, timeZone), bookings: [b] });
    }
  }

  return groups;
}

const TABS: Tab[] = ["upcoming", "past"];

function countUpcoming(bookings: HostBooking[]): number {
  return bookings.filter(isUpcoming).length;
}

function onChange(live: { bookings: HostBooking[] }, view: BookingsView) {
  let known = new Set(live.bookings.map((b) => b.id));
  live.bookings = fetchMyBookings();
  view.seen = live.bookings.filter((b) => !known.has(b.id)).map((b) => b.id);
}

function onCancel(b: HostBooking, view: BookingsView) {
  try {
    hostCancel(b.id);
    b.status = "cancelled";
    view.error = "";
  } catch (err: any) {
    view.error = err.message;
  }
}

function statusVariant(b: HostBooking): "danger" | "success" | "secondary" {
  if (b.status === "cancelled") {
    return "danger";
  }

  return isUpcoming(b) ? "success" : "secondary";
}

function statusLabel(b: HostBooking): string {
  if (b.status === "cancelled") {
    return "Cancelled";
  }

  return b.endsAt.getTime() > Date.now() ? "Confirmed" : "Completed";
}

<html lang="en" class="page-bookings" (
  host: Host,
  bookings: HostBooking[],
  listener: Listener<SlotChange>,
  private live: { bookings: HostBooking[] } = { bookings },
  private view: BookingsView = { tab: "upcoming", error: "", seen: [] },
) oninit={() => listener.on("notify", () => onChange(live, view))}>
  <head>
    <title>Bookings · slotnook</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <HostLayout active="bookings">
      <div class="stack is-lg">
        <div class="bookings-head row">
          <div class="stack is-xs">
            <h1>Bookings</h1>
            <p class="hint">Times in {zoneName(host.timeZone)} ({zoneAbbr(new Date(), host.timeZone)})</p>
          </div>
          <div class="share-link row">
            <span>Your page</span>
            <Button size="sm" href={`/${host.slug}`} attrs={{ target: "_blank" }}>/{host.slug}</Button>
          </div>
        </div>

        <Alert e:if={view.error} variant="danger" description={view.error} />

        <Tabs value={view.tab}>
          <TabsList label="Bookings">
            <TabsTrigger value="upcoming">Upcoming <Badge variant="secondary">{countUpcoming(live.bookings)}</Badge></TabsTrigger>
            <TabsTrigger value="past">Past and cancelled</TabsTrigger>
          </TabsList>

          <TabsContent e:for={tab of TABS} value={tab} class="stack is-lg">
            <div e:for={group of groupByDay(live.bookings, tab, host.timeZone)} class="day-group stack">
              <h2 class="day-label">{group.label}</h2>
              <Card>
                <div e:for={b of group.bookings}
                     class={["booking-row", b.status === "cancelled" && "is-cancelled", view.seen.includes(b.id) && "is-new"]}>
                  <div class="booking-time">
                    {formatTime(b.startsAt, host.timeZone)}
                    <small>to {formatTime(b.endsAt, host.timeZone)}</small>
                  </div>

                  <div class="booking-who stack">
                    <div class="cluster is-sm">
                      <strong>{b.guestName}</strong>
                      <Badge variant={statusVariant(b)}>{statusLabel(b)}</Badge>
                    </div>
                    <span class="booking-meta">{b.meetingName} · <a href={`mailto:${b.guestEmail}`}>{b.guestEmail}</a></span>
                    <span e:if={formatTime(b.startsAt, b.guestTimeZone) !== formatTime(b.startsAt, host.timeZone)} class="booking-meta">
                      {formatTime(b.startsAt, b.guestTimeZone)} for them in {zoneName(b.guestTimeZone)}
                    </span>
                    <p e:if={b.guestNote} class="booking-note">{b.guestNote}</p>
                  </div>

                  <div e:if={isUpcoming(b)} class="booking-actions row">
                    <Button size="sm" href={`/bookings/${b.id}/reschedule`}>Reschedule</Button>
                    <AlertDialog title={`Cancel ${b.guestName}'s booking?`}
                                 description={`${formatDay(b.startsAt, host.timeZone)} at ${formatTime(b.startsAt, host.timeZone)}. The guest gets an email and the time opens up again.`}>
                      <Button slot="trigger" variant="ghost" size="sm">Cancel</Button>
                      <AlertDialogFooter>
                        <AlertDialogCancel>Keep</AlertDialogCancel>
                        <AlertDialogAction variant="danger" onclick={() => onCancel(b, view)}>Cancel and email guest</AlertDialogAction>
                      </AlertDialogFooter>
                    </AlertDialog>
                  </div>
                </div>
              </Card>
            </div>

            <Empty e:if={groupByDay(live.bookings, tab, host.timeZone).length === 0} variant="outline">
              <EmptyDescription e:if={tab === "upcoming"}>Nothing booked yet. Share <a href={`/${host.slug}`} target="_blank">your booking page</a> to get started.</EmptyDescription>
              <EmptyDescription e:else>No past bookings yet.</EmptyDescription>
            </Empty>
          </TabsContent>
        </Tabs>
      </div>
    </HostLayout>
  </body>
</html>
