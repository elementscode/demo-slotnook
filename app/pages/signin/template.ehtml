import "./style.css";
import { redirect } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardHeader, CardTitle, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Item, ItemGroup, ItemContent, ItemTitle, ItemDescription, ItemActions } from "@elements/ui/item";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { signin } from "#app/shared/services/auth";
import { PublicLayout } from "#app/shared/templates/public-layout";
import { zoneName } from "#app/shared/lib/time";

export const DEMO_PASSWORD = "slotnook-demo";

export interface DemoLogin {
  id: string;
  name: string;
  email: string;
  headline: string;
  timeZone: string;
}

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

function onSubmit(form: SigninForm) {
  form.busy = true;
  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/bookings");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function useDemo(form: SigninForm, login: DemoLogin, password: string) {
  form.email = login.email;
  form.password = password;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  demo: DemoLogin[],
  password: string,
  private form: SigninForm = { email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · slotnook</title>
    <meta name="description" content="Sign in to manage your slotnook booking pages.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <PublicLayout width="is-form">
      <div class="auth-grid">
        <div class="auth-intro stack is-xs">
          <h1>Sign in</h1>
          <p class="lede">Manage your meeting types, hours and bookings.</p>
        </div>

        <form onsubmit={() => onSubmit(form)}>
          <Card size="sm">
            <CardContent class="stack">
              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Email">
                <Input value={form.email}
                       name="email"
                       type="email"
                       placeholder="you@example.com"
                       required
                       attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password">
                <Input value={form.password} name="password" type="password" required attrs={{ id: "password", autocomplete: "current-password" }} />
              </Field>

              <Button type="submit" variant="primary" block loading={form.busy}>Sign in</Button>

              <p class="hint">New here? <a href="/signup">Create a host account</a></p>
            </CardContent>
          </Card>
        </form>

        <section e:if={demo.length} aria-labelledby="demo-title">
          <Card size="sm">
            <CardHeader><CardTitle level={2} class="text-md"><span id="demo-title">Demo hosts</span></CardTitle></CardHeader>

            <CardContent>
              <ItemGroup label="Demo hosts">
              <Item e:for={login of demo} size="xs" class="demo-host">
                <ItemContent>
                  <ItemTitle>{login.name}</ItemTitle>
                  <ItemDescription>{login.email}</ItemDescription>
                  <ItemDescription>{zoneName(login.timeZone)}</ItemDescription>
                </ItemContent>
                <ItemActions>
                  <Button size="sm" disabled={form.busy} onclick={() => useDemo(form, login, password)}>Sign in</Button>
                </ItemActions>
              </Item>
              </ItemGroup>
              <p class="demo-password">Password for both: <code>{password}</code></p>
            </CardContent>
          </Card>
        </section>
      </div>
    </PublicLayout>
  </body>
</html>
