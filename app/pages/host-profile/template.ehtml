import "./style.css";
import { Avatar } from "@elements/ui/avatar";
import { Alert } from "@elements/ui/alert";
import { Card, CardContent } from "@elements/ui/card";
import { Icon } from "@elements/ui/icon";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Host, MeetingType } from "#app/shared/services/scheduling";
import { PublicLayout } from "#app/shared/templates/public-layout";
import { formatDuration, zoneName } from "#app/shared/lib/time";

export function initials(name: string): string {
  return name.split(/\s+/).map((w) => w[0] ?? "").join("").slice(0, 2).toUpperCase();
}

<html lang="en" class="page-host-profile" (host: Host, types: MeetingType[])>
  <head>
    <title>Book time with {host.name} · slotnook</title>
    <meta name="description" content={`Pick a time to meet with ${host.name}. ${host.headline}`}>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <PublicLayout width="is-form">
      <div class="stack is-lg">
        <div class="host-card stack">
          <Avatar class="host-avatar" fallback={initials(host.name)} />
          <h1>{host.name}</h1>
          <p e:if={host.headline} class="lede">{host.headline}</p>
          <p class="hint">Based in {zoneName(host.timeZone)}. Times are shown in yours.</p>
        </div>

        <div e:if={types.length} class="type-list stack">
          <a e:for={type of types} class="type-link" href={`/${host.slug}/${type.slug}`}>
            <Card>
              <CardContent class="row">
                <div class="stack is-xs">
                  <h2 class="type-name">{type.name}</h2>
                  <p class="type-desc">{formatDuration(type.durationMinutes)}{type.description ? ` · ${type.description}` : ""}</p>
                </div>
                <Icon class="type-arrow" name="chevron-right" size={20} />
              </CardContent>
            </Card>
          </a>
        </div>

        <Alert e:else role="none" description={`${host.name} has no meeting types open right now.`} />
      </div>
    </PublicLayout>
  </body>
</html>
