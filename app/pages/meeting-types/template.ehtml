import "./style.css";
import { session, sql, ValidationError } from "@elements/app";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardHeader, CardTitle, CardContent } from "@elements/ui/card";
import { Checkbox } from "@elements/ui/checkbox";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { InputGroup, InputGroupAddon, InputGroupText } from "@elements/ui/input-group";
import { Label } from "@elements/ui/label";
import { NativeSelect } from "@elements/ui/native-select";
import { Textarea } from "@elements/ui/textarea";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Host, MeetingType, notifyHoursChanged } from "#app/shared/services/scheduling";
import { slugify } from "#app/shared/services/auth";
import { HostLayout } from "#app/shared/templates/host-layout";
import { formatDuration } from "#app/shared/lib/time";

export interface MeetingTypeForm {
  id: string;
  name: string;
  slug: string;
  description: string;
  duration: string;
  buffer: string;
  active: boolean;
}

interface TypesView {
  editing: string;
  form: MeetingTypeForm;
  errors: Record<string, string[]>;
  busy: boolean;
  copied: string;
}

export const DURATIONS = [15, 20, 30, 45, 60, 90, 120].map((m) => ({ id: String(m), minutes: m }));
export const BUFFERS = [0, 5, 10, 15, 30, 60].map((m) => ({ id: String(m), minutes: m }));

const DURATION_OPTIONS = DURATIONS.map((d) => ({ value: d.id, label: formatDuration(d.minutes) }));
const BUFFER_OPTIONS = BUFFERS.map((b) => ({ value: b.id, label: b.minutes ? `${b.minutes} min` : "None" }));

export function loadMeetingTypes(userId: string): MeetingType[] {
  return sql<MeetingType>(`
    select * from meetingTypes where userId = ${userId} order by active desc, durationMinutes, name
  `).all();
}

/** @rpc */
export function saveMeetingType(form: MeetingTypeForm): MeetingType[] {
  let userId = session.getOrThrow("userId");
  let name = form.name.trim();
  let slug = slugify(form.slug || form.name);
  let duration = Number(form.duration);
  let buffer = Number(form.buffer);

  let errors: Record<string, string[]> = {};
  if (!name) {
    errors.name = ["Give it a name"];
  }

  if (!slug) {
    errors.slug = ["Use letters or numbers"];
  }

  if (!Number.isInteger(duration) || duration < 5 || duration > 480) {
    errors.duration = ["Between 5 and 480 minutes"];
  }

  if (!Number.isInteger(buffer) || buffer < 0 || buffer > 240) {
    errors.buffer = ["Between 0 and 240 minutes"];
  }

  let clash = !sql(`
    select 1 from meetingTypes where userId = ${userId} and slug = ${slug} and id is distinct from ${form.id || null}::uuid
  `).empty();

  if (clash) {
    errors.slug = ["You already have a meeting type at this link"];
  }

  if (Object.keys(errors).length) {
    throw new ValidationError(errors);
  }

  if (form.id) {
    sql(`
      update meetingTypes
         set name = ${name}, slug = ${slug}, description = ${form.description.trim()},
             durationMinutes = ${duration}, bufferMinutes = ${buffer}, active = ${form.active}
       where id = ${form.id} and userId = ${userId}
    `);
  } else {
    sql(`
      insert into meetingTypes (userId, name, slug, description, durationMinutes, bufferMinutes, active)
           values (${userId}, ${name}, ${slug}, ${form.description.trim()}, ${duration}, ${buffer}, ${form.active})
    `);
  }

  notifyHoursChanged(userId);

  return loadMeetingTypes(userId);
}

function blankForm(): MeetingTypeForm {
  return { id: "", name: "", slug: "", description: "", duration: "30", buffer: "10", active: true };
}

function toForm(t: MeetingType): MeetingTypeForm {
  return {
    id: t.id,
    name: t.name,
    slug: t.slug,
    description: t.description,
    duration: String(t.durationMinutes),
    buffer: String(t.bufferMinutes),
    active: t.active,
  };
}

function onNew(view: TypesView) {
  view.editing = "new";
  view.form = blankForm();
  view.errors = {};
}

function onEdit(view: TypesView, t: MeetingType) {
  view.editing = t.id;
  view.form = toForm(t);
  view.errors = {};
}

function onName(view: TypesView) {
  if (view.editing === "new") {
    view.form.slug = slugify(view.form.name);
  }
}

function onSave(view: TypesView, live: { types: MeetingType[] }) {
  view.busy = true;
  try {
    live.types = saveMeetingType(view.form);
    view.editing = "";
    view.errors = {};
  } catch (err: any) {
    view.errors = err instanceof ValidationError && err.errors
      ? err.errors as Record<string, string[]>
      : { name: [err.message] };
  }

  view.busy = false;
}

function onToggle(t: MeetingType, live: { types: MeetingType[] }) {
  live.types = saveMeetingType({ ...toForm(t), active: !t.active });
}

async function onCopy(view: TypesView, url: string, id: string) {
  await navigator.clipboard.writeText(url);
  view.copied = id;
  setTimeout(() => view.copied = "", 1500);
}

<TypeForm (view: TypesView, live: { types: MeetingType[] }, host: Host)>
  <form class="type-form stack" onsubmit={() => onSave(view, live)}>
    <Field label="Name" error={view.errors.name?.[0] ?? ""}>
      <Input value={view.form.name} oninput={() => onName(view)} placeholder="Strategy session" required attrs={{ id: "type-name" }} />
    </Field>

    <Field label="Link" error={view.errors.slug?.[0] ?? ""}>
      <InputGroup>
        <InputGroupAddon><InputGroupText>/{host.slug}/</InputGroupText></InputGroupAddon>
        <Input value={view.form.slug} attrs={{ id: "type-slug", spellcheck: "false", autocapitalize: "none" }} />
      </InputGroup>
    </Field>

    <Field label="Description">
      <Textarea value={view.form.description} rows={3} placeholder="What the guest should expect" attrs={{ id: "type-desc" }} />
    </Field>

    <div class="grid grid-cols-2 gap-4">
      <Field label="Length" error={view.errors.duration?.[0] ?? ""}>
        <NativeSelect value={view.form.duration} options={DURATION_OPTIONS} block attrs={{ id: "type-duration" }} />
      </Field>

      <Field label="Buffer between meetings" error={view.errors.buffer?.[0] ?? ""}>
        <NativeSelect value={view.form.buffer} options={BUFFER_OPTIONS} block attrs={{ id: "type-buffer" }} />
      </Field>
    </div>

    <div class="row type-form-foot">
      <Label><Checkbox checked={view.form.active} /> Show on my booking page</Label>
      <div class="cluster is-sm">
        <Button variant="ghost" onclick={() => view.editing = ""}>Cancel</Button>
        <Button type="submit" variant="primary" loading={view.busy}>{view.editing === "new" ? "Create" : "Save"}</Button>
      </div>
    </div>
  </form>
</TypeForm>

<html lang="en" class="page-meeting-types" (
  host: Host,
  types: MeetingType[],
  private live: { types: MeetingType[] } = { types },
  private view: TypesView = { editing: "", form: blankForm(), errors: {}, busy: false, copied: "" },
  private origin: { value: string } = { value: "" },
) oninit={() => origin.value = location.origin}>
  <head>
    <title>Meeting types · slotnook</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <HostLayout active="meeting-types">
      <div class="stack is-lg">
        <div class="types-head row">
          <div class="stack is-xs">
            <h1>Meeting types</h1>
            <p class="hint">Each one gets its own booking link.</p>
          </div>
          <Button e:if={view.editing !== "new"} variant="primary" onclick={() => onNew(view)}>New meeting type</Button>
        </div>

        <Card e:if={view.editing === "new"}>
          <CardHeader><CardTitle level={2}>New meeting type</CardTitle></CardHeader>
          <CardContent><TypeForm {view} {live} {host} /></CardContent>
        </Card>

        <Card e:for={t of live.types} class={t.active ? "type-card" : "type-card is-off"}>
          <CardContent e:if={view.editing === t.id}><TypeForm {view} {live} {host} /></CardContent>

          <CardContent e:else class="type-view">
            <div class="stack is-sm">
              <div class="cluster is-sm">
                <h2 class="type-title">{t.name}</h2>
                <Badge e:if={!t.active} variant="secondary">Hidden</Badge>
              </div>
              <span class="type-facts">{formatDuration(t.durationMinutes)} · {t.bufferMinutes ? `${t.bufferMinutes} min buffer` : "No buffer"}</span>
              <p e:if={t.description} class="type-desc">{t.description}</p>
              <a class="type-url" href={`/${host.slug}/${t.slug}`} target="_blank">{origin.value}/{host.slug}/{t.slug}</a>
            </div>

            <div class="type-actions row">
              <Button size="sm" variant="ghost" onclick={() => onCopy(view, `${origin.value}/${host.slug}/${t.slug}`, t.id)}>{view.copied === t.id ? "Copied" : "Copy link"}</Button>
              <Button size="sm" variant="ghost" onclick={() => onToggle(t, live)}>{t.active ? "Hide" : "Show"}</Button>
              <Button size="sm" onclick={() => onEdit(view, t)}>Edit</Button>
            </div>
          </CardContent>
        </Card>
      </div>
    </HostLayout>
  </body>
</html>
