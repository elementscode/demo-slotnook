import "./style.css";
import { session, redirect } from "@elements/app";
import { signout } from "#app/shared/services/auth";
import { BrandMark } from "#app/shared/templates/public-layout";

function onSignout() {
  signout();
  redirect("/signin");
}

<HostLayout (active: string)>
  <div class="app">
    <header class="site-header">
      <div class="page-shell row site-header-inner">
        <a class="brand row" href="/bookings"><BrandMark/> slotnook</a>

        <nav class="host-nav row" aria-label="Host">
          <a href="/bookings" class={[active === "bookings" && "is-active"]}>Bookings</a>
          <a href="/meeting-types" class={[active === "meeting-types" && "is-active"]}>Meeting types</a>
          <a href="/availability" class={[active === "availability" && "is-active"]}>Availability</a>
        </nav>

        <div class="host-account row">
          <a class="host-public button is-ghost is-sm" href={`/${session.get("userSlug")}`} target="_blank">Your booking page</a>
          <button class="is-sm" onclick={() => onSignout()}>Sign out</button>
        </div>
      </div>
    </header>

    <main class="page-shell host-main">
      <slot/>
    </main>
  </div>
</HostLayout>
